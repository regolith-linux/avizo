#!/bin/sh
#---help---
# Usage:
#   $0 [options] <command> [<value>[%]]
#   $0 [options] (+|-)<value>%
#   $0 [options] [=]<value>%
#   $0 -h
#
# Adjust the sound or mic volume using 'pamixer' and show an on-screen
# notification using 'avizo-client'.
#
# Commands:
#   + | up           Increase the volume by <value> percents (defaults to 5).
#   - | down         Decrease the volume by <value> percents (defaults to 5).
#   = | set          Set volume to <value> percents.
#   x | mute         Set mute.
#   u | unmute       Unset mute.
#   % | toggle-mute  Switch between mute and unmute.
#   show             Show the current volume without changing it.
#
# Options (also accepted after the command):
#   -b               Allow volume to go above 100% (boost).
#   -m               Control the source (mic) instead of sink (output).
#   -M <monitornr>   Set monitor where notification will be shown
#                      ('focused' for the focused one).
#   -n               Name the device in the notification, unless it is a
#                      built-in speaker (as GNOME does).
#   -N               Always name the device in the notification.
#   -u               Unmute when changing the volume (+|-|=).
#   -d               Show dark theme friendly variant of the icon
#   -h               Show this message and exit.
#
# This script is part of the avizo package.
#---help---
# This script is POSIX Shell Command Language compliant.
set -eu

if ( set -o pipefail 2>/dev/null ); then
	set -o pipefail
fi

PROGNAME='volumectl'

help() {
	local tag='---help---'
	sed -n "/^#$tag/,/^#$tag/{/^#$tag/d; s/^# \\?//; s|\$0|$0|; p}" "$0"
}

die() {
	printf "$PROGNAME: %s\n" "$1" >&2
	exit 1
}

is_integer() {
	expr "$1" : '[0-9]\+$' >/dev/null
}

playing_dev_id() {
	if command -v pactl >/dev/null; then
		pactl list short ${1}s | grep RUNNING | grep -m1 -o '^[0-9]\+'
	else  # this works since pamixer 1.6
		pamixer --list-${1}s | grep '"Running"' | grep -m1 -o '^[0-9]\+'
	fi
}

set_property_cmd() {
  if [ $1 != "source" ] &&  [ $1 != "sink" ]; then
    die "Unknown stream type: $1"
  fi
  echo "set-$1-$2"
}

get_property_val_cmd() {
  if [ $1 != "source" ] && [ $1 != "sink" ]; then
    die "Unknown stream type: $1"
  fi
  echo "get-$1-$2"
}

# Prints the volume of the sink or source ($1) named $2 in percents.
get_volume() {
  pactl $(get_property_val_cmd "$1" "volume") "$2" | head -n 1 | awk '{print substr($5, 1, length($5)-1)}'
}

# Prints 1 if the default sink or source ($1) is muted, else 0. No grep here:
# the script runs with pipefail where the shell has it, and a grep that finds
# nothing would end the script.
is_muted() {
  dev_type_upper=$(echo "$1" | tr '[:lower:]' '[:upper:]')
  case "$(pactl "get-$1-mute" "@DEFAULT_${dev_type_upper}@")" in
    *yes*) echo 1;;
    *) echo 0;;
  esac
}

# Prints the name of the default sink or source ($1) for the notification:
# the description of its active port and its own description, e.g.
# "Headphones – Built-in Audio Analog Stereo". If $2 is 'external', prints
# nothing for a built-in speaker (form factor 'internal' on no port or a
# speaker port), which is when gnome-settings-daemon shows no name either.
device_label() {
	default_name=$(pactl "get-default-$1")
	# Untranslated field names; the values are as the server gives them.
	LC_ALL=C.UTF-8 pactl list "${1}s" | awk -v name="$default_name" -v which="$2" '
		{ line = $0; sub(/^[ \t]+/, "", line) }
		/^[^ \t]/ { if (found) exit; next }
		!found { if (line == "Name: " name) found = 1; next }
		/^\t[^\t]/ { section = line }
		line ~ /^Description: / { description = substr(line, 14); next }
		line ~ /^Active Port: / { active = substr(line, 14); next }
		section == "Properties:" && line ~ /^device\.form_factor = / {
			form_factor = line
			sub(/^[^"]*"/, "", form_factor)
			sub(/"$/, "", form_factor)
			next
		}
		section == "Ports:" && /^\t\t[^\t]/ {
			i = index(line, ": ")
			port_description = substr(line, i + 2)
			sub(/ \([^()]*\)$/, "", port_description)
			ports[substr(line, 1, i - 1)] = port_description
		}
		END {
			if (!found) exit
			if (which == "external" && form_factor == "internal" &&
			    (active == "" || active == "[OUT] Speaker" || active == "[OUT] Handset" ||
			     active == "analog-output-speaker" || active == "analog-output")) exit
			label = description
			if (active != "" && ports[active] != "" && ports[active] != description) {
				label = ports[active] (description == "" ? "" : " – " description)
			}
			print label
		}'
}

allow_boost=false
dev_type='sink'
unmute=false
dark=0
monitor=-1
name_device=''
optind=1
while getopts ':bdp:mM:nNuh' OPT; do
	case "$OPT" in
		b) allow_boost=true;;
		d) dark=1;;
		m) dev_type='source';;
		M) monitor="$OPTARG";;
		n) name_device='external';;
		N) name_device='always';;
		u) unmute=true;;
		h) help; exit 0;;
		\?) case "$OPTARG" in
		    	[0-9]*) break;;
		    	*) die "unknown option: -$OPTARG";;
		    esac
		;;
	esac
	optind=$OPTIND  # hack to make -<value>% work correctly
done
shift $((optind -1))

# Options may also follow the command (e.g. 'volumectl + 5 -b' or
# 'volumectl show -M focused'). Walk the remaining arguments once, keeping
# the ones that are not options; n counts the arguments not yet looked at.
n=$#
while [ $n -gt 0 ]; do
	arg=$1
	shift
	n=$((n - 1))
	case "$arg" in
		-b) allow_boost=true;;
		-d) dark=1;;
		-m) dev_type='source';;
		-n) name_device='external';;
		-N) name_device='always';;
		-u) unmute=true;;
		-h) help; exit 0;;
		-M)
			[ $n -gt 0 ] || die "option requires an argument: -M"
			monitor=$1
			shift
			n=$((n - 1));;
		-M?*) monitor=${arg#-M};;
		*) set -- "$@" "$arg";;
	esac
done

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
	die "invalid number of arguments (see '$0 -h')"
fi

case "$1" in
	[=+-][0-9]*%) cmd=${1%%[0-9]*}; value=${1#[=+-]};;
	[0-9]*%) cmd='='; value=$1;;
	*) cmd=$1; value=${2:-5};;
esac
value=${value%\%}

if ! is_integer "$value"; then
	die "invalid value: '$value'"
fi

# Note: 'raise' and 'lower' are only for backward compatibility with
#  the previous version of this script.

cmd_type=""
is_volume_cmd=false
case "$cmd" in
	+ | up | raise) 
    cmd_opt="+$value%"
    is_volume_cmd=true
    cmd_type=$(set_property_cmd "$dev_type" "volume");;
	- | down | lower) 
    cmd_opt="-$value%"
    is_volume_cmd=true
    cmd_type=$(set_property_cmd "$dev_type" "volume");;
	= | set) 
    cmd_opt="$value%"
    is_volume_cmd=true
    cmd_type=$(set_property_cmd "$dev_type" "volume");;
	x | mute) 
    cmd_opt='true' 
    cmd_type=$(set_property_cmd "$dev_type" "mute");;
	u | unmute) 
    cmd_opt='false' 
    cmd_type=$(set_property_cmd "$dev_type" "mute");;
	% | toggle-mute) 
    cmd_opt='toggle'
    cmd_type=$(set_property_cmd "$dev_type" "mute");;
	show) ;;
	*) die "invalid command: $cmd (see '$0 -h')";;
esac

dev_type_upper=$(echo $dev_type |tr '[:lower:]' '[:upper:]')
dev_opt="@DEFAULT_$dev_type_upper@"

# Without -b, raising or setting stops at 100%.
if ! $allow_boost; then
	case "$cmd" in
		+ | up | raise)
			current=$(get_volume "$dev_type" "$dev_opt")
			if is_integer "$current" && [ $((current + value)) -gt 100 ]; then
				cmd_opt='100%'
			fi;;
		= | set)
			if [ "$value" -gt 100 ]; then
				cmd_opt='100%'
			fi;;
	esac
fi

if $is_volume_cmd && $unmute; then
 pactl "set-$dev_type-mute" $dev_opt false
fi

if [ -n "$cmd_type" ]; then
	pactl $cmd_type $dev_opt $cmd_opt
fi

muted=$(is_muted $dev_type)
volume=$(get_volume $dev_type $dev_opt)

if ! is_integer "$volume"; then
	die "pactl returned invalid volume level: '$volume'"
fi

case "$dev_type" in
	sink)
		if [ "$muted" -gt "0" ]; then
			image='volume_muted'
		elif [ "$volume" -le 33 ]; then
			image='volume_low'
		elif [ "$volume" -le 66 ]; then
			image='volume_medium'
		else
			image='volume_high'
		fi
	;;
	source)
		if [ "$muted" -gt "0" ]; then
			image='mic_muted'
		else
			image='mic_unmuted'
		fi
	;;
esac

if [ "$dark" -eq 1 ]; then
	image="${image}_dark"
fi

progress=$(echo "$volume" | awk '{ printf "%.2f", ($1 > 100 ? 1 : $1 / 100) }')
if [ "$monitor" = focused ]; then
	set -- --focused-output --monitor=-1
else
	set -- --monitor="$monitor"
fi
if [ -n "$name_device" ]; then
	label=$(device_label "$dev_type" "$name_device" 2>/dev/null) || label=''
	if [ -n "$label" ]; then
		set -- "$@" --text="$label"
	fi
fi
avizo-client --image-resource="$image" --progress="$progress" "$@"
